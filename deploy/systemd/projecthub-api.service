[Unit]
Description=ChitoProject web administration
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=projecthub
Group=projecthub
WorkingDirectory=/opt/projecthub/app
EnvironmentFile=/etc/projecthub/projecthub.env
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=/opt/projecthub/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/projecthub/uploads

[Install]
WantedBy=multi-user.target
