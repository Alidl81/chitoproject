APP_ENV=production
APP_NAME=ChitoProject
PUBLIC_BASE_URL=https://projects.example.com
DATABASE_URL=postgresql+asyncpg://chitoproject:CHANGE_THIS@127.0.0.1:5432/chitoproject
SECRET_KEY=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_32_BYTES
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BALE_BOT_USERNAME=
UPLOADS_DIR=/var/lib/chitoproject/uploads
MAX_UPLOAD_MB=20
MAX_ARCHIVE_MB=500
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BOT_POLLING_TIMEOUT=25
BOT_API_TIMEOUT=35
BOT_WORKER_CONCURRENCY=8

# Optional manual payment for Bale. Leave both empty until configured.
CHECKOUT_BASE_URL=
ZARINPAL_MERCHANT_ID=
MANUAL_PAYMENT_CARD=
PAYMENT_ARCHIVE_KEY=
